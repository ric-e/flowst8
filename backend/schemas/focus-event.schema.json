{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Focus Event",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "source",
    "timestamp",
    "data"
  ],
  "additionalProperties": false
}