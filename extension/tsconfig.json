{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src_ts",
    "lib": ["ES2022"],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": ["node", "vscode"]
  },
  "include": ["src_ts/**/*.ts"],
  "exclude": ["node_modules", ".vscode-test"]
}
